[Unit]
Description=Effectors Hosted Worker
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/effectors/Effectors/backend
EnvironmentFile=/opt/effectors/Effectors/deploy/linux/env.backend
ExecStart=/opt/effectors/Effectors/backend/.venv/bin/python -m hosted_api.worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

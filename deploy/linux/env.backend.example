# Hosted API runtime
EFFECTOR_HOSTED_APP_NAME=Effector Hosted API
EFFECTOR_HOSTED_DATABASE_URL=sqlite:////opt/effectors/Effectors/backend/hosted_api/data/jobs.db
EFFECTOR_PUBLIC_BASE_URL=https://api.example.com
EFFECTOR_EMAIL_FROM=noreply@example.com

# SMTP for real email delivery. If left blank, the app writes email previews.
EFFECTOR_SMTP_HOST=
EFFECTOR_SMTP_PORT=587
EFFECTOR_SMTP_USERNAME=
EFFECTOR_SMTP_PASSWORD=
EFFECTOR_SMTP_STARTTLS=true

# Worker
EFFECTOR_WORKER_POLL_INTERVAL=5

# Execution mode
# Use local for now. hpc is reserved for future MedicineBow submission wiring.
EFFECTOR_EXECUTION_MODE=local

# Hosted API runtime
EFFECTOR_HOSTED_APP_NAME=Effector Hosted API
EFFECTOR_HOSTED_DATABASE_URL=sqlite:////opt/effectors/Effectors/backend/hosted_api/data/jobs.db
EFFECTOR_PUBLIC_BASE_URL=https://api.example.com
EFFECTOR_EMAIL_FROM=noreply@example.com
EFFECTOR_CORS_ALLOWED_ORIGINS=https://app.example.com

# SMTP for real email delivery. If left blank, the app writes email previews.
EFFECTOR_SMTP_HOST=
EFFECTOR_SMTP_PORT=587
EFFECTOR_SMTP_USERNAME=
EFFECTOR_SMTP_PASSWORD=
EFFECTOR_SMTP_STARTTLS=true

# Worker
EFFECTOR_WORKER_POLL_INTERVAL=5
EFFECTOR_JOB_LEASE_SECONDS=900
EFFECTOR_JOB_HEARTBEAT_SECONDS=15

# Execution mode
EFFECTOR_EXECUTION_MODE=local
EFFECTOR_HPC_SSH_BIN=ssh
EFFECTOR_HPC_SCP_BIN=scp
EFFECTOR_HPC_SSH_ARGS=
EFFECTOR_HPC_SCP_ARGS=
EFFECTOR_HPC_REMOTE_HOST=medicinebow
EFFECTOR_HPC_REMOTE_EFFECTORS_ROOT=/home/gokulsrinathseetharam/projects/Effectors
EFFECTOR_HPC_REMOTE_RUNS_ROOT=/gscratch/gokulsrinathseetharam/runs/effectors
EFFECTOR_HPC_REMOTE_RESULTS_ROOT=/gscratch/gokulsrinathseetharam/results/effectors
EFFECTOR_HPC_REMOTE_LOGS_ROOT=/gscratch/gokulsrinathseetharam/logs/effectors
EFFECTOR_HPC_SLURM_ACCOUNT=effectorfold
EFFECTOR_HPC_SLURM_PARTITION=
EFFECTOR_HPC_SLURM_TIME=01:00:00
EFFECTOR_HPC_SLURM_MEM=8G
EFFECTOR_HPC_SLURM_CPUS=2
EFFECTOR_HPC_SLURM_GPUS=0
EFFECTOR_HPC_SLURM_GPUS_ALPHAFOLD=1

# Optional: shell snippet inserted into the Slurm script before running the job.
# Use this to `module load`, `conda activate`, and to export AlphaFold tool vars.
EFFECTOR_HPC_JOB_PROLOGUE=
EFFECTOR_HPC_JOB_EPILOGUE=
EFFECTOR_HPC_PYTHON_BIN=python3

# AlphaFold runner (executed on the HPC node inside the Slurm job environment).
# Defaults assume ColabFold is available.
EFFECTOR_ALPHAFOLD_BIN=colabfold_batch
EFFECTOR_ALPHAFOLD_ARGS=

# Guardrails
EFFECTOR_MAX_UPLOAD_BYTES=26214400
EFFECTOR_MAX_SEQUENCE_CHARS=200000
EFFECTOR_MAX_JOB_ATTEMPTS=2
EFFECTOR_RATE_LIMIT_WINDOW_SECONDS=60
EFFECTOR_RATE_LIMIT_CREATE_JOB_LIMIT=30

# Required if you want to use admin endpoints like GET /jobs and POST /jobs/{id}/run.
EFFECTOR_ADMIN_API_KEY=

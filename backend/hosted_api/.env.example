EFFECTOR_HOSTED_APP_NAME=Effector Hosted API
EFFECTOR_HOSTED_DATABASE_URL=sqlite:///./backend/hosted_api/data/jobs.db
EFFECTOR_PUBLIC_BASE_URL=http://localhost:8000
EFFECTOR_EMAIL_FROM=noreply@example.com

# Optional SMTP settings. If EFFECTOR_SMTP_HOST is unset, the app writes
# email previews to backend/hosted_api/data/logs/email-previews/ instead.
EFFECTOR_SMTP_HOST=
EFFECTOR_SMTP_PORT=587
EFFECTOR_SMTP_USERNAME=
EFFECTOR_SMTP_PASSWORD=
EFFECTOR_SMTP_STARTTLS=true

# Worker and execution mode settings.
EFFECTOR_WORKER_POLL_INTERVAL=5
EFFECTOR_EXECUTION_MODE=local

# Guardrails
EFFECTOR_MAX_UPLOAD_BYTES=26214400
EFFECTOR_MAX_SEQUENCE_CHARS=200000
EFFECTOR_MAX_JOB_ATTEMPTS=2

# Optional admin key for protected endpoints like GET /jobs and POST /jobs/{id}/run.
EFFECTOR_ADMIN_API_KEY=

EFFECTOR_HOSTED_APP_NAME=Effector Hosted API
EFFECTOR_HOSTED_DATABASE_URL=sqlite:///./backend/hosted_api/data/jobs.db
EFFECTOR_PUBLIC_BASE_URL=http://localhost:8000
EFFECTOR_EMAIL_FROM=noreply@example.com

# Optional SMTP settings. If EFFECTOR_SMTP_HOST is unset, the app writes
# email previews to backend/hosted_api/data/logs/email-previews/ instead.
EFFECTOR_SMTP_HOST=
EFFECTOR_SMTP_PORT=587
EFFECTOR_SMTP_USERNAME=
EFFECTOR_SMTP_PASSWORD=
EFFECTOR_SMTP_STARTTLS=true

# Worker and execution mode settings.
EFFECTOR_WORKER_POLL_INTERVAL=5
EFFECTOR_EXECUTION_MODE=local

# Guardrails
EFFECTOR_MAX_UPLOAD_BYTES=26214400
EFFECTOR_MAX_SEQUENCE_CHARS=200000
EFFECTOR_MAX_JOB_ATTEMPTS=2

# Optional admin key for protected endpoints like GET /jobs and POST /jobs/{id}/run.
EFFECTOR_ADMIN_API_KEY=

# -----------------------------------------------------------------------------
# Optional HPC execution mode (EFFECTOR_EXECUTION_MODE=hpc)
# -----------------------------------------------------------------------------
# The hosted worker submits jobs to Slurm over SSH. Configure an SSH host alias
# on the API machine (not inside the cluster) so `ssh <alias>` works without a
# password prompt.
#
# Example ~/.ssh/config entry:
#   Host medicinebow
#     HostName login.your-cluster.edu
#     User your_netid
#     IdentityFile ~/.ssh/id_ed25519
#     IdentitiesOnly yes
#
# Remote host alias used by ssh/scp.
EFFECTOR_HPC_REMOTE_HOST=medicinebow
# Optional extra ssh/scp args (space-separated). Example: "-i C:/keys/id_ed25519"
EFFECTOR_HPC_SSH_ARGS=
EFFECTOR_HPC_SCP_ARGS=

# Remote paths (must be writable by your cluster account).
# - EFFECTOR_HPC_REMOTE_EFFECTORS_ROOT should point at a clone of this repo on the cluster.
EFFECTOR_HPC_REMOTE_EFFECTORS_ROOT=/home/youruser/projects/Effectors
EFFECTOR_HPC_REMOTE_RUNS_ROOT=/gscratch/youruser/runs/effectors
EFFECTOR_HPC_REMOTE_RESULTS_ROOT=/gscratch/youruser/results/effectors
EFFECTOR_HPC_REMOTE_LOGS_ROOT=/gscratch/youruser/logs/effectors

# Slurm settings (adjust to match your cluster).
EFFECTOR_HPC_SLURM_ACCOUNT=your_account
EFFECTOR_HPC_SLURM_PARTITION=
EFFECTOR_HPC_SLURM_TIME=01:00:00
EFFECTOR_HPC_SLURM_MEM=8G
EFFECTOR_HPC_SLURM_CPUS=2
EFFECTOR_HPC_SLURM_GPUS=0
EFFECTOR_HPC_SLURM_GPUS_ALPHAFOLD=1

# Optional job prologue/epilogue (multi-line is allowed). Typical use: load modules / activate env.
# Example:
#   EFFECTOR_HPC_JOB_PROLOGUE=module load tm-align blast+ python/3.11
EFFECTOR_HPC_JOB_PROLOGUE=
EFFECTOR_HPC_JOB_EPILOGUE=

# Remote python used to run backend/hosted_api/remote_runner.py (inside the repo clone).
EFFECTOR_HPC_PYTHON_BIN=python3

# Optional AlphaFold/ColabFold integration (sequence jobs only when run_alphafold=true)
EFFECTOR_ALPHAFOLD_BIN=colabfold_batch
EFFECTOR_ALPHAFOLD_ARGS=
